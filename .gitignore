.DS_Store
.idea/
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
# pytest-cov 覆盖率缓存（运行时产物，不进仓库）
.coverage
apps/backend/.coverage

logs/*.log
logs/*.pid
storage/*.sqlite
storage/*.sqlite3
storage/*.sqlite3-shm
storage/*.sqlite3-wal
storage/*.db
storage/backend.bootstate.json

# 本地 Agent 项目数据（非缓存，但属本地运行产物，不提交）
.codebuddy/
apps/backend/.env
apps/backend/.env.local

# CodeGraph 索引缓存
.codegraph/
# CodeGraph 锁定 node 运行时（随应用分发，不提交仓库）
apps/backend/.codegraph-node/

# Tauri 生成产物
apps/desktop/src-tauri/gen/

# 临时调试脚本（环境可能重建为空文件，避免误提交）
apps/backend/tests/_tmp_*.py
apps/backend/_trace_dbg.py
apps/backend/temp/
apps/desktop/temp/
.filter-replace.txt

# 前端依赖（不应提交）
node_modules/
/.tmp/
/.workbuddy/
/.agents/
/.npm-cache/
/.superpowers/
/temp/

# CodeGraph Kernel 运行/构建产物（运行时生成，不应提交）
apps/backend/.workspace_event-node/
third_party/codegraph/dist/
third_party/codegraph/node_modules/
