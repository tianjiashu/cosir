.DS_Store
.idea/
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
# pytest-cov 覆盖率缓存（运行时产物，不进仓库）
.coverage
apps/backend/.coverage


logs/*.log
logs/*.pid
storage/*.sqlite
storage/*.sqlite3
storage/*.sqlite3-shm
storage/*.sqlite3-wal
storage/*.sqlite-shm
storage/*.sqlite-wal
storage/*.db
storage/backend.bootstate.json

# 本地 Agent 项目数据（非缓存，但属本地运行产物，不提交）
.codebuddy/
apps/backend/.env
apps/backend/.env.local
.env
.env.local
!.env.example
!apps/backend/.env.example

# 本地 workspace 索引数据（保留已有数据，不提交）
.codegraph/
# 本地 workspace 运行时数据（不提交）
.workspace_event/
.workspace_payload/

# Tauri 生成产物（gen/ 仍按 crate 相对路径生成）
apps/desktop/src-tauri/gen/
# 统一 Rust 构建产物目录（由仓库根 .cargo/config.toml 的 target-dir 指定）：
# 保留 target 目录本身，忽略其中的全部构建产物（靠 .gitkeep 维持目录被跟踪）
/target/*
!/target/.gitkeep
# Tauri bundle staging（由 build:bundle 按当前平台生成）
apps/desktop/src-tauri/resources/terminal-worker/
!apps/desktop/src-tauri/resources/backend/
apps/desktop/src-tauri/resources/backend/*
!apps/desktop/src-tauri/resources/backend/.gitkeep
apps/backend/.venv-packaging/
apps/backend/build/
apps/backend/dist/
/apps/desktop/artifacts/

# 临时调试脚本（环境可能重建为空文件，避免误提交）
apps/backend/tests/_tmp_*.py
apps/backend/_trace_dbg.py
apps/backend/temp/
apps/desktop/temp/
.filter-replace.txt

# 前端依赖（不应提交）
node_modules/
/.tmp/
/.workbuddy/
/.agents/
/.npm-cache/
/.superpowers/
/temp/

/apps/backend/_probe_atomic_tmp/

# 临时调试产物（环境重建/测试跑出的零散文件，避免误提交）
_orig.txt
apps/backend/_bg_out.txt
apps/backend/_bnd_out.txt
apps/backend/_full_out.txt
apps/backend/_orig_test_tmp.py
apps/backend/_probe_atomic.py
apps/backend/_probe_rollback.py
apps/backend/_reg_out.txt
task3_pytest*.log

# git worktree 工作目录（由 git worktree 管理，不纳入 main 跟踪）
.worktrees/

# Langfuse 回放本地产物（运行时下载，不提交）
storage/langfuse-replays/

# Langfuse trace 调试导出（运行时生成，不提交）
logs/trace_*.json
logs/trace_*_raw.txt

# 临时验证程序（调试用，非源码）
apps/desktop/src-tauri/verify_stem.rs
apps/desktop/src-tauri/verify_stem.exe
apps/desktop/src-tauri/verify_stem.pdb

# Agent 运行时产物（workspace 级与系统级 `.cosir`）
.cosir/

# 桌面端临时调试产物（vitest/tsc 输出、覆盖率缓存、日志转储）
apps/desktop/coverage-tmp/
apps/desktop/*.log
apps/desktop/rp*.txt
apps/desktop/tsc_err.txt
apps/desktop/tsc_out.txt
logs/*.log.*

# 桌面端调试转储与测试输出（运行期产物，不提交）
apps/desktop/dbg.txt
apps/desktop/vitest_out.txt
apps/desktop/src/tests/.vitest-full-run.txt

# 仓库根 vitest 运行转储（运行期产物，不提交）
temp_gen_out.txt

# 本地 IDE 配置（Trae）
.trae/
/.uv-cache*
/.tauri-target-terminal/
/.cargo/
.superpowers
/apps/backend/.pytest*
.pytest*
/.jez/
/macos-release/
