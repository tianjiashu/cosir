.DS_Store
.idea/
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
# pytest-cov 覆盖率缓存（运行时产物，不进仓库）
.coverage
apps/backend/.coverage

logs/*.log
logs/*.pid
storage/*.sqlite
storage/*.sqlite3
storage/*.sqlite3-shm
storage/*.sqlite3-wal
storage/*.sqlite-shm
storage/*.sqlite-wal
storage/*.db
storage/backend.bootstate.json

# 本地 Agent 项目数据（非缓存，但属本地运行产物，不提交）
.codebuddy/
apps/backend/.env
apps/backend/.env.local

# CodeGraph 索引缓存
.codegraph/
# CodeGraph workspace 运行时数据库（本地运行产物，不提交）
.workspace_event/
.workspace_payload/
# CodeGraph 锁定 node 运行时（随应用分发，不提交仓库）
apps/backend/.workspace_payload-node/

# Tauri 生成产物
apps/desktop/src-tauri/gen/

# 临时调试脚本（环境可能重建为空文件，避免误提交）
apps/backend/tests/_tmp_*.py
apps/backend/_trace_dbg.py
apps/backend/temp/
apps/desktop/temp/
.filter-replace.txt

# 前端依赖（不应提交）
node_modules/
/.tmp/
/.workbuddy/
/.agents/
/.npm-cache/
/.superpowers/
/temp/

apps/backend/.workspace_event-node/

# CodeGraph Kernel 运行/构建产物（运行时生成，不应提交）
third_party/codegraph/dist/
third_party/codegraph/node_modules/
/apps/backend/_probe_atomic_tmp/

# 临时调试产物（环境重建/测试跑出的零散文件，避免误提交）
_orig.txt
apps/backend/_bg_out.txt
apps/backend/_bnd_out.txt
apps/backend/_full_out.txt
apps/backend/_orig_test_tmp.py
apps/backend/_probe_atomic.py
apps/backend/_probe_rollback.py
apps/backend/_reg_out.txt
task3_pytest*.log

# git worktree 工作目录（由 git worktree 管理，不纳入 main 跟踪）
.worktrees/

# Langfuse 回放本地产物（运行时下载，不提交）
storage/langfuse-replays/

# Langfuse trace 调试导出（运行时生成，不提交）
logs/trace_*.json
logs/trace_*_raw.txt

# 临时验证程序（调试用，非源码）
apps/desktop/src-tauri/verify_stem.rs
apps/desktop/src-tauri/verify_stem.exe
apps/desktop/src-tauri/verify_stem.pdb

# Agent 运行时产物
.coding-agent/

# 桌面端临时调试产物（vitest/tsc 输出、覆盖率缓存、日志转储）
apps/desktop/coverage-tmp/
apps/desktop/rp*.txt
apps/desktop/tsc_err.txt
apps/desktop/tsc_out.txt
logs/*.log.*

# 桌面端调试转储与测试输出（运行期产物，不提交）
apps/desktop/dbg.txt
apps/desktop/vitest_out.txt
apps/desktop/src/tests/.vitest-full-run.txt

# 本地 IDE 配置（Trae）
.trae/
/.uv-cache/
