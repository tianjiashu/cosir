{
  "name": "dsh-delegate",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Local HTTP bridge that lets external agents list, create, and drive DeepSeek Harness workspaces and sessions.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
