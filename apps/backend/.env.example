# 本文件只是模板。运行时配置只有一个生效位置（system_cosir.env_file()，其余位置一律不生效）：
#   <数据根>/.cosir/.env（macOS 为 ~/.cosir/.env，Windows 为 %USERPROFILE%\.cosir\.env；
#   桌面应用与直接运行后端相同；设置了 CODING_AGENT_DATA_DIR 时以它为数据根）
# 注意：apps/backend/.env 不会被任何代码读取（历史上误放在此处的配置一律不生效，已删除）。
# 改完需重启应用（provider 在工具注册期构造）。

# 键名与 Settings 字段完全同名（不再使用 CODING_AGENT_ 前缀）。
MAIN_AGENT_MAX_STEPS=300


# 代理：无需在此声明。系统代理由后端自动探测（Windows 注册表），总开关为 CODING_AGENT_PROXY_AUTO_DETECT（默认开）。
# 历史上为 litellm 提供的 CODING_AGENT_WEB_PROXY_URL / _API_KEY 已随 litellm（2026-09-19 移除）作废，代码零引用，不要再用。
