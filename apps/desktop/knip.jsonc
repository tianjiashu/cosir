{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // vite / playwright / eslint / postcss 的配置文件与 global-setup、src/main.tsx 由 knip 插件自动识别为入口。
  "entry": [
    "electron/main/app.ts",
    "electron/preload/index.ts",
    "scripts/*.mjs",
    "tests/e2e/test-server.mjs",
    "tests/e2e/**/*.spec.ts",
    "tests/unit/**/*.test.{ts,tsx}",
    "tests/desktop-e2e/**/*.spec.ts"
  ],
  "project": ["**/*.{js,jsx,ts,tsx,mjs,cjs,css}"]
}
