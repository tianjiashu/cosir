{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cosir",
  "version": "0.1.0",
  "identifier": "com.cosir.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 3000",
    "beforeBuildCommand": "npm run build:bundle",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../../target/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cosir",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../../target/resources/terminal-worker/": "terminal-worker/",
      "../../../target/resources/backend/": "backend/"
    }
  }
}
