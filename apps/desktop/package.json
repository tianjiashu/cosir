{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "main": "../../target/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "node scripts/run-electron-dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "tsc --noEmit && tsc -p electron && vite build && node scripts/build-electron.mjs",
    "build:bundle": "npm run build && npm run stage:terminal-worker && npm run stage:backend",
    "stage:terminal-worker": "node scripts/stage-terminal-worker.mjs",
    "stage:backend": "node scripts/stage-backend.mjs",
    "test:terminal-worker-bundle": "node scripts/verify-terminal-worker-bundle.mjs",
    "start": "vite preview",
    "lint": "eslint",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "npm run build && playwright test -c playwright.desktop.config.ts",
    "knip": "knip"
  },
