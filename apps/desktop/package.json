{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "tauri:dev": "node scripts/run-tauri-dev.mjs",
    "tauri:build": "node scripts/run-tauri-build.mjs --config src-tauri/tauri.conf.json",
    "tauri:build:portable": "node scripts/run-tauri-build.mjs --no-bundle --config src-tauri/tauri.conf.json && node scripts/stage-portable.mjs",
    "build": "tsc --noEmit && vite build",
    "build:bundle": "npm run build && npm run stage:terminal-worker && npm run stage:backend",
    "build:tauri:e2e": "npm run build:bundle && node scripts/run-tauri-build.mjs --debug --no-bundle --features desktop-e2e",
    "stage:terminal-worker": "node scripts/stage-terminal-worker.mjs",
    "stage:backend": "node scripts/stage-backend.mjs",
    "test:terminal-worker-bundle": "node scripts/verify-terminal-worker-bundle.mjs",
    "start": "vite preview",
    "lint": "eslint",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:tauri": "wdio run wdio.tauri.conf.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@assistant-ui/react-streamdown": "^0.3.13",
    "@base-ui/react": "^1.7.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@react-symbols/icons": "^1.4.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "elkjs": "^0.12.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.37.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-markdown": "2.1.2",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-arborist": "^3.16.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-router-dom": "^7.9.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@wdio/cli": "^9.31.7",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.4.0",
    "eslint": "^9",
    "knip": "^6.41.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "ws": "^8.22.0"
  }
}
